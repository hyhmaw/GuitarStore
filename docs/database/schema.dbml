Table users {
  id int [pk, increment]
  name varchar [not null]
  email varchar [not null, unique]
  password_hash varchar [not null]
  role varchar [not null]
  managed_category_id int
  created_at timestamp [not null]
}

Table categories {
  id int [pk, increment]
  name varchar [not null, unique]
}

Table products {
  id int [pk, increment]
  name varchar [not null]
  description text [not null]
  price int [not null]
  stock_quantity int [not null]
  is_limited boolean [not null]
  category_id int [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table product_images {
  id int [pk, increment]
  product_id int [not null]
  image_url varchar [not null]
  sort_order int [not null]
}

Table tags {
  id int [pk, increment]
  name varchar [not null, unique]
}

Table product_tags {
  product_id int [not null]
  tag_id int [not null]
  added_at timestamp [not null]

  indexes {
    (product_id, tag_id) [pk]
  }
}

Table orders {
  id int [pk, increment]
  user_id int [not null]
  status varchar [not null]
  delivery_address varchar [not null]
  total_price int [not null]
  idempotency_key varchar [not null, unique]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table order_items {
  id int [pk, increment]
  order_id int [not null]
  product_id int [not null]
  product_name varchar [not null]
  quantity int [not null]
  price_at_purchase int [not null]
}

Table reviews {
  id int [pk, increment]
  user_id int [not null]
  product_id int [not null]
  rating int [not null]
  comment text [not null]
  is_hidden boolean [not null]
  has_complaint boolean [not null]
  created_at timestamp [not null]
}

Ref: products.category_id > categories.id

Ref: product_images.product_id > products.id

Ref: product_tags.product_id > products.id

Ref: product_tags.tag_id > tags.id

Ref: orders.user_id > users.id

Ref: order_items.order_id > orders.id

Ref: order_items.product_id > products.id

Ref: reviews.user_id > users.id

Ref: reviews.product_id > products.id

Ref: users.managed_category_id > categories.id