// use prisma-8

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  passwordHash      String    @map("password_hash")
  role              String
  managedCategoryId Int?      @map("managed_category_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  managedCategory   Category? @relation("ManagerCategory", fields: [managedCategoryId], references: [id])
  orders            Order[]
  reviews           Review[]

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique

  products  Product[]
  managers  User[]    @relation("ManagerCategory")

  @@map("categories")
}

model Product {
  id             Int            @id @default(autoincrement())
  name           String
  description    String
  price          Int
  stockQuantity  Int            @map("stock_quantity")
  isLimited      Boolean        @default(false) @map("is_limited")
  specifications Json?
  categoryId     Int            @map("category_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @onCreate(now()) @onUpdate(now()) @map("updated_at")

  category       Category       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  tags           Tag[]
  orderItems     OrderItem[]
  reviews        Review[]

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  imageUrl  String  @map("image_url")
  sortOrder Int     @default(0) @map("sort_order")

  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique

  products Product[]

  @@map("tags")
}

model ProductTag {
  productId Int      @map("product_id")
  tagId     Int      @map("tag_id")
  addedAt   DateTime @default(now()) @map("added_at")

  product   Product  @relation(fields: [productId], references: [id])
  tag       Tag      @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
  @@map("product_tags")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int         @map("user_id")
  status          String
  deliveryAddress String      @map("delivery_address")
  totalPrice      Int         @map("total_price")
  idempotencyKey  String      @unique @map("idempotency_key")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @onCreate(now()) @onUpdate(now()) @map("updated_at")

  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  productId       Int      @map("product_id")
  productName     String   @map("product_name")
  quantity        Int
  priceAtPurchase Int      @map("price_at_purchase")

  order           Order    @relation(fields: [orderId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Review {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  productId    Int      @map("product_id")
  rating       Int
  comment      String
  isHidden     Boolean  @default(false) @map("is_hidden")
  hasComplaint Boolean  @default(false) @map("has_complaint")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@unique([userId, productId])
  @@map("reviews")
}